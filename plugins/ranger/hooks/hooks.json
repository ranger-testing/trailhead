{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=session-start"
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=session-end"
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "matcher": "Plan",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=plan-start"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=auto-prompt"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=plan-reminder"
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=pre-compact"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=post-edit"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=plan-reminder"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=plan-reminder"
                    }
                ]
            }
        ],
        "PermissionRequest": [
            {
                "matcher": "ExitPlanMode",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=exit-plan-mode",
                        "timeout": 345600
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "npx @ranger-testing/ranger-cli hook --name=stop"
                    }
                ]
            },
            {
                "hooks": [
                    {
                        "type": "prompt",
                        "prompt": "Review the conversation transcript and determine if a Ranger feature review was created or verified during this session. If so, the agent must include a final message with a link to the feature review on the Ranger dashboard (https://dashboard.ranger.net/features/{feature_id}) and direct the user to visit it. Context: $ARGUMENTS",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
